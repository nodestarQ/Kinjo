# Copy to .env. Values are public and end up in the built app.
PUBLIC_KINJO_CHAIN_ID=11155111
PUBLIC_KINJO_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
PUBLIC_KINJO_ONBOARDING=0x0000000000000000000000000000000000000000
# Empty: owners pay their own gas.
PUBLIC_RELAYER_URL=
# Shown the "Release name" button (demo reset).
PUBLIC_KINJO_TEAM=0x281770ab3731C474a7F7ab00FfE0A4A92Bf6aCaD
# Set to ws://127.0.0.1:8765 where the browser's Web Serial fails (Chrome on Linux)
PUBLIC_SERIAL_HELPER=
# Block the contract was deployed in (device list starts there)
PUBLIC_KINJO_DEPLOY_BLOCK=11787264
