# web/.env on the server (docker compose reads it). Never commit the real one.
KINJO_DOMAIN=kinjo.example.com
KINJO_ONBOARDING=0x...
# Key of the kinjo.eth wallet (contract owner). It pays the gas for sponsored calls. Testnet only.
RELAYER_PRIVATE_KEY=0x...
# Host port for nginx to proxy to (only on 127.0.0.1). Change it if 8787 is taken.
KINJO_PORT=8787
# World ID badge (optional), from developer.world.org. staging works with the simulator.
WORLD_APP_ID=
WORLD_RP_ID=
WORLD_RP_SIGNING_KEY=
WORLD_ENVIRONMENT=staging
# Staging only: token you get when opening a staging verification window (valid 24 h)
WORLD_STAGING_TOKEN=
